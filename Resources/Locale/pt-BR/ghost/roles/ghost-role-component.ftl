ghost-role-information-medical-virologist-name = Virologista
ghost-role-information-medical-geneticist-name = Geneticista
ghost-role-information-medical-dentist-name = Dentista
ghost-role-information-medical-description = Você é profissional da medicina, mas parece ter caído em uma situação estranha...
ghost-role-information-cargo-name = Carga
ghost-role-information-cargo-description = Você faz parte de uma missão logística, mas parece ter caído em uma situação estranha...
